# ---- large / local-only files (never pushed) ----
# datasets (download instructions: data/README.md)
data/*
!data/README.md

# model checkpoints (1.5-3.3 GB each; see README "Models")
inference/models/*.pth
inference/models/archive_run1/

# generated outputs: keep summaries and a few images, drop raw arrays
*.npy
*.pfm
inference/outputs/classical_baseline/*/vis/*
!inference/outputs/classical_baseline/*/vis/middlebury_Adirondack.png

# personal phone photos (demo) - not published
inference/test_images/akshit/
inference/test_images/akshit_rectified/
inference/test_images/deepak/
inference/test_images/deepak_rectified/

# copyrighted / unrelated documents kept only locally
docs/local_only/

# upstream FoundationStereo media (not needed to run the code)
FoundationStereo/teaser/

